{% extends 'base.html.twig' %}

{% block title %}{{ salon.name }}{% endblock %}

{% block body %}

<h1>{{ salon.name }}</h1>

<p>{{ salon.description }}</p>

<hr>

<h2>Messages</h2>

{% if salon.messages|length > 0 %}

    {% for message in salon.messages %}
        <div class="card mb-3">
            <div class="card-body">

                <strong>
                    {{ message.author.username }}
                </strong>

                <small class="text-muted">
                    {{ message.createdAt|date('d/m/Y H:i') }}
                </small>

                <p class="mt-2">
                    {{ message.content }}
                </p>

            </div>
        </div>
    {% endfor %}

{% else %}
    <p>Aucun message dans ce salon.</p>
{% endif %}

<hr>

<h2>Envoyer un message</h2>

{{ form_start(form) }}
    {{ form_widget(form) }}

    <button class="btn btn-primary mt-2">
        Envoyer
    </button>
{{ form_end(form) }}

<hr>

<a class="btn btn-secondary" href="{{ path('app_salon_index') }}">
    Retour aux salons
</a>

{% if salon.owner == app.user %}
    <a class="btn btn-warning" href="{{ path('app_salon_edit', {'id': salon.id}) }}">
        Modifier
    </a>

    {{ include('salon/_delete_form.html.twig') }}
{% endif %}

{% endblock %}