{% extends 'base.html.twig' %}

{% block title %}Salons{% endblock %}

{% block body %}
    <h1>Salons</h1>
    <p><a class="btn" href="{{ path('app_salon_new') }}">+ Nouveau salon</a></p>

    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Créé par</th>
                <th>Créé le</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for salon in salons %}
            <tr>
                <td><a href="{{ path('app_salon_show', {id: salon.id}) }}"># {{ salon.name }}</a></td>
                <td>{{ salon.description }}</td>
                <td>{{ salon.owner.username }}</td>
                <td>{{ salon.createdAt|date('d/m/Y H:i') }}</td>
                <td>
                    {% if salon.owner == app.user %}
                        <a href="{{ path('app_salon_edit', {id: salon.id}) }}">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucun salon pour le moment.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}